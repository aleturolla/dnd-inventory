{
  "compilerOptions": {
    "allowJs": true,
    "module": "es2015",
    "moduleResolution": "node",
    "jsx": "react",
    "target": "es2017",
    "allowSyntheticDefaultImports": false,
    "baseUrl": "./",
    "paths": {
      "Common/*": ["src/common/*"],
      "Components/*": ["src/components/*"],
      "Containers/*": ["src/containers/*"],
      "Hoc/*": ["src/hoc/*"],
      "Store": ["src/redux-store/store.js"],
      "Actions/*": ["src/redux-store/actions/*"],
      "Reducers/*": ["src/redux-store/reducers/*"],
      "Routes/*": ["src/routes"]
    }
  },
  "exclude": ["node_modules", "build"]
}
